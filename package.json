{
  "name": "@releasium/ngx-grand-validator",
  "description": "A powerful validation library for Angular applications, providing custom validators implemented using decorators.",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/releasium/ngx-grand-validator.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint .",
    "format": "prettier --write \"lib/**/*.ts\" \"*.{json,js,md}\"",
    "format:check": "prettier --check \"lib/**/*.ts\" \"*.{json,js,md}\"",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "release": "npm run build && npm publish ./dist/ngx-grand-validator"
  },
  "private": false,
  "dependencies": {
    "@angular/common": "21.2.22",
    "@angular/compiler": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/forms": "21.2.22",
    "@angular/platform-browser": "21.2.22",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.22",
    "@angular/cli": "21.2.22",
    "@angular/compiler-cli": "21.2.22",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "jsdom": "^26.0.0",
    "ng-packagr": "^21.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "angular",
    "validation",
    "reactive forms",
    "ngx-grand-validation",
    "form validation",
    "model validation",
    "decorator validation",
    "client-side validation",
    "angular forms",
    "angular reactive forms",
    "form validation library",
    "model-driven forms",
    "form validation decorators",
    "angular form validation",
    "form validation rules",
    "angular form validation",
    "ngx validator"
  ]
}
